{
  "name": "supreme-scrutiny",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "python ../scripts/export_web_data.py",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:serve": "wrangler dev --local --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "us-atlas": "^3.0.1",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
